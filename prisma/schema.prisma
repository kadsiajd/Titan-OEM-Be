generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  STATUS_CHANGE
  LOGIN
}

enum SpecificationFieldType {
  TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  TABLE
}

enum ProductStatus {
  PUBLISHED
  ARCHIVED
  DRAFT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String     @unique
  dateOfBirth  DateTime   @map("date_of_birth") @db.Date
  mobileNumber String     @map("mobile_number")
  employeeId   String     @unique @map("employee_id")
  status       UserStatus @default(ACTIVE)
  plantId      String     @map("plant_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  functionId   String     @map("function_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  plant        Plant      @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  function     Function   @relation(fields: [functionId], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[] @relation("AuditLogActor")

  @@index([plantId])
  @@index([departmentId])
  @@index([functionId])
  @@index([deletedAt])
  @@map("users")
}

model Plant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plants")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Function {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("functions")
}

model File {
  id               String             @id @default(uuid()) @db.Uuid
  fileName         String             @map("file_name")
  filePath         String             @map("file_path")
  fileSize         BigInt             @map("file_size")
  categories       Category[]
  customers        Customer[]
  productDocuments productDocuments[]
  productImages    ProductImages[]
  createdAt        DateTime           @default(now()) @map("created_at")
  deletedAt        DateTime?          @map("deleted_at")

  @@index([deletedAt])
  @@map("files")
}

model productDocuments {
  id         String          @id @default(uuid()) @db.Uuid
  fileType   ProductFileType
  filePathId String          @db.Uuid
  filePath   File            @relation(fields: [filePathId], references: [id])
  productId  String          @db.Uuid
  product    Product         @relation(fields: [productId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?       @map("deleted_at")
}

model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  categoryId     String                 @db.Uuid
  category       Category               @relation(fields: [categoryId], references: [id])
  status         ProductStatus          @default(DRAFT)
  name           String
  description    String
  images         ProductImages[]
  specifications ProductSpecification[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  documents      productDocuments[]

  @@index([deletedAt])
  @@index([status])
}

model ProductImages {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @db.Uuid
  filePathId String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [filePathId], references: [id], onDelete: Restrict)

  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([productId])
  @@index([filePathId])
  @@index([deletedAt])
}

enum ProductFileType {
  SPEC_SHEET
  TECHNICAL_DRAWING
}

model ProductSpecification {
  id              String                @id @default(uuid()) @db.Uuid
  productId       String                @db.Uuid
  specificationId String                @db.Uuid
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  specification   CategorySpecification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  value           String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([productId, specificationId])
}

model Category {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String                  @unique
  shortDescription String
  briefDescription String?
  filePathId       String                  @map("file_path_id") @db.Uuid
  file             File                    @relation(fields: [filePathId], references: [id], onDelete: Restrict)
  specifications   CategorySpecification[]
  products         Product[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  @@index([deletedAt])
}

model CategorySpecification {
  id                  String                 @id @default(uuid()) @db.Uuid
  categoryId          String                 @db.Uuid
  category            Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldName           String
  fieldKey            String
  fieldType           SpecificationFieldType
  placeholder         String?
  isRequired          Boolean                @default(false)
  isVisibleInOverview Boolean                @default(false)
  isFilterable        Boolean                @default(false)
  displayOrder        Int                    @default(0)
  productValues       ProductSpecification[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?

  @@unique([categoryId, fieldKey])
  @@index([deletedAt])
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  filePathId String    @map("file_path_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  file       File?     @relation(fields: [fileId], references: [id])
  fileId     String?   @db.Uuid

  @@map("customers")
}

model Enquiry {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  company   String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("enquiries")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actor      User?       @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  summary    String?
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
