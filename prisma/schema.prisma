generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String     @unique
  dateOfBirth  DateTime   @map("date_of_birth") @db.Date
  mobileNumber String     @map("mobile_number")
  employeeId   String     @unique @map("employee_id")
  status       UserStatus @default(ACTIVE)
  plantId      String     @map("plant_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  functionId   String     @map("function_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  plant        Plant      @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  function     Function   @relation(fields: [functionId], references: [id], onDelete: Restrict)

  @@index([plantId])
  @@index([departmentId])
  @@index([functionId])
  @@map("users")
}

model Plant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plants")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Function {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("functions")
}

model File {
  id         String     @id @default(uuid()) @db.Uuid
  fileName   String     @map("file_name")
  filePath   String     @map("file_path")
  fileSize   BigInt     @map("file_size")
  categories Category[]
  customers  Customer[]
  createdAt  DateTime   @default(now()) @map("created_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@index([deletedAt])
  @@map("files")
}

model Category {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  description String
  filePathId  String @map("file_path_id") @db.Uuid
  file        File   @relation(fields: [filePathId], references: [id], onDelete: Restrict)

  @@index([filePathId])
  @@map("categories")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  filePathId String   @map("file_path_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  file       File?    @relation(fields: [fileId], references: [id])
  fileId     String?  @db.Uuid

  @@map("customers")
}
